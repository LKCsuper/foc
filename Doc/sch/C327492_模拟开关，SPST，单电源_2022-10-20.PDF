         <pdf:Producer>Acrobat Distiller 18.0 (Windows)</pdf:Producer>
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2020-09-16T14:13:07+02:00</xmp:ModifyDate>
         <xmp:CreateDate>2019-02-15T15:15:49-07:00</xmp:CreateDate>
         <xmp:MetadataDate>2020-09-16T14:13:07+02:00</xmp:MetadataDate>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MC74VHC1G66 - SPST Normally Open (NO) Analog Switch</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ON Semiconductor</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The MC74VHC1G66 is a single pole single throw (SPST) analog&#xD;&#xA;switch. It achieves high speed propagation delays and low ON&#xD;&#xA;resistances while maintaining low power dissipation. This bilateral&#xD;&#xA;switch controls analog and digital voltages that may vary across the&#xD;&#xA;full powerâˆ’supply range (from VCC to GND).&#xD;&#xA;The MC74VHC1G66 is compatible in function to a single gate of&#xD;&#xA;the High Speed CMOS MC74VHC4066 and the metalâˆ’gate CMOS&#xD;&#xA;MC14066. The device has been designed so that the ON resistances&#xD;&#xA;(RON) are much lower and more linear over input voltage than RON of&#xD;&#xA;the metalâˆ’gate CMOS or High Speed CMOS analog switches.&#xD;&#xA;The ON/OFF control inputs are compatible with standard CMOS&#xD;&#xA;outputs. The ON/OFF control input structure provides protection when&#xD;&#xA;voltages between 0 V and 5.5 V are applied, regardless of the supply&#xD;&#xA;voltage. This input structure helps prevent device destruction caused by&#xD;&#xA;supply voltage âˆ’ input/output voltage mismatch, battery backup,&#xD;&#xA;hot insertion, etc.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:aadb5a89-8b49-46d3-ba98-25f3a5d1ea07</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:52364709-d5c9-49fd-b1ba-f1c60be624f8</xmpMM:InstanceID>
         <illustrator:StartupProfile>Print</illustrator:StartupProfile>
      </rdf:Description>
   </rdf:RDF>
